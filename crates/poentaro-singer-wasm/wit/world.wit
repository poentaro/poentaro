package poentaro:singer;

world poentaro-singer {
    // One part's stretch of a song, sung on its own (see
    // `poentaro_singer::SungPiece`).
    record sung-piece {
        part: u32,
        start-sample: u32,
        samples: list<f32>,
    }

    // A singing plan (the bytes `poentaro-wasm`'s `singing-plan` returns) is
    // sung as pieces, which can be sung in parallel and then mixed into mono
    // samples at the plan's sample rate, to mix into the instruments.
    export piece-count: func(plan: list<u8>) -> result<u32, string>;
    export sing-piece: func(plan: list<u8>, index: u32) -> result<sung-piece, string>;
    export mix: func(plan: list<u8>, pieces: list<sung-piece>) -> result<list<f32>, string>;
}
