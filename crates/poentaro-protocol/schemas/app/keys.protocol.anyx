TYPE Key Id: Text,

# A key an agent signs in with. Only its start is ever shown again.
RECORD Key {
    id: Key Id,
    # The start of the key, such as `poe_AbCd1234`.
    prefix: Text,
    created at: Instant,
    last used at: OPTIONAL Instant,
    expires at: Instant,
    # Whether it had stopped working when it was listed.
    expired: Boolean,
},

RECORD Created Key {
    key: Key,
    # What the owner pastes into their agent. It holds the whole key.
    prompt: Text,
},

# The account's keys, newest first.
READ ONLY METHOD list agent keys RETURNS keys: LIST Key,

METHOD create agent key RETURNS created: Created Key,

IDEMPOTENT METHOD revoke agent key (id: Key Id) RETURNS NOTHING ERRORS [
        # No key of this account has this id.
        missing key,
    ] EXAMPLES [revoke agent key ("key-a" AS Key Id) RETURNS NOTHING],
