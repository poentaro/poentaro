USE "./paths.protocol.anyx",

# A file in the account's tree, without its score.
PUBLIC RECORD File Summary {
    # Made by the browser that created the file. It never changes.
    id: Text,
    # A slash path, such as `Hymns/hymn.poentaro`.
    path: Text,
    revision: Integer,
    # When the file went to the trash.
    trashed at: OPTIONAL Instant,
},

RECORD File { summary: File Summary, content: Text },

PUBLIC ERRORS lookup errors [
    # This account has no file with this id.
    missing,
],

PUBLIC ERRORS file errors [
    # The file is in the trash. Restore it first.
    trashed,
] + lookup errors,

PUBLIC ERRORS conflict errors [(path: Text) would be both file and folder],

PUBLIC ERRORS path errors [
    # Another file, in the trash or not, has this path.
    taken,
] + conflict errors + bad path,

# Every file this account owns, the trash included.
READ ONLY METHOD list files
    RETURNS (files: LIST File Summary)
    EXAMPLES [list files RETURNS []],

# A file and its score. A file in the trash can be read too.
READ ONLY METHOD read file (id: Text)
    RETURNS (file: File)
    ERRORS lookup errors,

# Saves the score, if the file is still at `revision`. A score that doesn't
# parse is saved too.
METHOD write file (id: Text) at revision (revision: Integer) content (content: Text)
    RETURNS (revision: Integer)
    ERRORS [
        # Someone saved first. The file is now at `revision`, with `content`.
        conflict at revision (revision: Integer) content (content: Text),
    ] + file errors
    EXAMPLES [
        write file "file-a" at revision 3 content "new score" RETURNS 4,
        write file "file-a" at revision 3 content "new score" ERROR conflict at revision 4 content "current score",
    ],

# Makes a new file, and its folders if they don't exist.
METHOD create file (id: Text) at (path: Text) content (content: Text)
    RETURNS (file: File Summary)
    ERRORS [
        # Another file already has this id.
        id taken,
    ] + path errors
    EXAMPLES [
        create file "file-a" at "../hymn.poentaro" content "" ERROR invalid path "Parent segments are not allowed",
    ],

# Moves or renames a file. Its link keeps working.
METHOD move file (id: Text) to (path: Text)
    RETURNS NOTHING
    ERRORS path errors + lookup errors,

# Moves the file to the trash. `restore file` brings it back.
IDEMPOTENT METHOD trash file (id: Text)
    RETURNS NOTHING
    ERRORS lookup errors,

# Brings a file back from the trash. If its path has been taken since, it
# comes back under a free one, such as `hymn 2.poentaro`.
METHOD restore file (id: Text)
    RETURNS (path: Text)
    ERRORS [
        # The file isn't in the trash.
        not trashed,
    ] + conflict errors + lookup errors,
