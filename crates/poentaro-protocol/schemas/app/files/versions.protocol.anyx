USE "../files.protocol.anyx",

# An earlier version of a file.
RECORD Version { revision: Integer, saved at: Instant },

# The file's earlier versions, newest first. The current score isn't one
# of them.
READ ONLY METHOD list versions of file (id: Text)
    RETURNS (versions: LIST Version)
    ERRORS lookup errors,

READ ONLY METHOD read file (id: Text) at revision (revision: Integer)
    RETURNS (content: Text)
    ERRORS [
        # The file has no earlier version at this revision.
        no such version,
    ] + lookup errors,
