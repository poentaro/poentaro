USE "./errors.protocol.anyx",

RECORD Session {
    # Send as `Authorization: Bearer <token>` to `poentaro app`.
    token: Text,
    # The account's name, trimmed and lowercased.
    email: Text,
},

ERRORS credential errors [
    # This isn't shaped like an email.
    invalid email,
] + rate limit errors,

METHOD sign up (email: Text) password (password: Text) RETURNS (session: Session) ERRORS [
        # This email already has an account. Sign in instead.
        email taken,
        # The password isn't strong enough; `message` says why.
        weak password (message: Text),
    ] + credential errors,

METHOD sign in (email: Text) password (password: Text) RETURNS (session: Session) ERRORS [
        # The email has no account, or the password is wrong.
        incorrect,
        # Too many wrong passwords for this email.
        locked for (duration: Duration),
    ] + credential errors EXAMPLES [sign in "owner@example.com" password "example only" ERROR locked for (1 minute 30 seconds)],
